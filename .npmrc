engine-strict=true
auto-install-peers=true
strict-peer-dependencies=false

# Supply-chain hardening — applied 2026-05-25 in response to ongoing
# Shai-Hulud / Mini Shai-Hulud / TeamPCP waves (active campaign throughout
# 2025-09 → 2026-05). See SECURITY.md "Supply-chain defense layers".

# Disable lifecycle scripts (postinstall / preinstall / install) — the primary
# execution vector in the original Shai-Hulud worm. This repo has no native
# compilation step.
ignore-scripts=true

# 7-day cooldown — refuse to install any package version published less than
# 10080 minutes (= 7 days) ago. Absorbs essentially all known supply-chain
# attack lifetimes (axios March 2026 = 4-5 h; Shai-Hulud TanStack May 2026 =
# 22 min publish burst). pnpm 10.16 (2025-09) shipped minimumReleaseAge.
minimum-release-age=10080

# Audit-time floor: fail `pnpm audit` on high-or-critical advisories.
audit-level=high
